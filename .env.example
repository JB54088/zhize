# Local development defaults only. Never put production credentials here.
AI_ENGINE_URL=http://127.0.0.1:8001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional local PostgreSQL development database. Leave unset to use local SQLite.
# DATABASE_URL=postgresql+psycopg://zhize:zhize@127.0.0.1:5432/zhize_dev

# Real search provider. Without a local key the engine returns an explicit 503.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SEARCH_BASE_URL=https://api.tavily.com/search
SEARCH_TIMEOUT_SECONDS=30

# Optional OpenAI-compatible annotation API. It cannot create search results.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Local development defaults only. Never put production credentials here.
AI_ENGINE_URL=http://127.0.0.1:8001
AI_ENGINE_TIMEOUT_SECONDS=210
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional local PostgreSQL development database. Leave unset to use local SQLite.
# DATABASE_URL=postgresql+psycopg://zhize:zhize@127.0.0.1:5432/zhize_dev

# Real search providers. Without a local key for a selected provider the engine
# returns an explicit configuration/error status; it never fabricates results.
SEARCH_PROVIDER=baidu
# Baidu Qianfan Web Search API. Put the local AppBuilder API Key here.
BAIDU_SEARCH_API_KEY=
# Optional alternate sources. Select Tavily only when its local key is configured.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
# Used only when SEARCH_PROVIDER=tavily.
SEARCH_BASE_URL=https://api.tavily.com/search
SEARCH_TIMEOUT_SECONDS=30
# Optional allowlist for non-government official domains, comma-separated.
OFFICIAL_SOURCE_DOMAINS=

# Optional OpenAI-compatible DeepSeek API. The key belongs in your local .env only.
# `deepseek-chat` is a retired legacy identifier; use a model currently exposed
# by the provider, such as `deepseek-flash`, or another compatible model.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# `auto` disables DeepSeek's default high-effort thinking for bounded JSON/tool calls;
# other OpenAI-compatible endpoints receive no provider-specific thinking field.
LLM_THINKING=auto
LLM_REQUEST_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
# Optional provider pricing, USD per 1M tokens. Leave blank to report token use
# without estimating cost.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=

# Hard caps for DeepSeek-assisted follow-up research.
RESEARCH_MAX_ROUNDS=3
RESEARCH_MAX_SEARCH_REQUESTS=12
RESEARCH_MAX_MODEL_CALLS=8
RESEARCH_MAX_TOTAL_TOKENS=16000
RESEARCH_MAX_CANDIDATES=60
RESEARCH_MAX_ELAPSED_SECONDS=90
RESEARCH_MAX_RESULTS_PER_QUERY=8
RESEARCH_MAX_PROMPT_TOKENS=8000
RESEARCH_MAX_COMPLETION_TOKENS=2400
RESEARCH_MAX_TOOL_CALLS_PER_ROUND=2
RESEARCH_MAX_CONTEXT_CANDIDATES=6
RESEARCH_MAX_CONTEXT_SOURCES=3
RESEARCH_MAX_TOOL_OUTPUT_CHARS=8000
